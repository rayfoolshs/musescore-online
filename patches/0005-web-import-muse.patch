+static bool hasFileBelow(const std::map<muse::io::path_t, muse::ByteArray>& files, const muse::io::path_t& dirPath)
+{
+    const std::string dirPrefix = dirPath.toStdString() + "/";
+    for (const auto& item : files) {
+        if (muse::strings::startsWith(item.first.toStdString(), dirPrefix)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
 muse::Ret MemFileSystem::exists(const muse::io::path_t& path) const
 {
     if (isRC(path)) {
         return QFile::exists(path.toQString());
-    } else {
-        return muse::contains(m_files, path);
     }
+
+    if (muse::contains(m_files, path)) {
+        return muse::make_ok();
+    }
+
+    //! NOTE There are no directory entries in this filesystem: a path is also considered to
+    //! exist if a stored file lives below it. MuseScore's uncompressed project reader
+    //! (`.mscx`, Dir mode) checks that the containing directory exists before reading the
+    //! score file from it.
+    if (hasFileBelow(m_files, path)) {
+        return muse::make_ok();
+    }
+
+    return make_ret(Err::FSNotExist);
 }
 
