+    UNUSED(buttons);
+    UNUSED(options);
+    UNUSED(dialogTitle);
+
+    //! NOTE The web shell has no dialog surface: the QML provider opens stray top-level
+    //! windows that linger over the app (and would show internal paths). Log the message
+    //! and answer with the default button; the web shell reports user-visible problems itself.
+    LOGW() << "question: " << contentTitle << ": " << text.text;
+    return async::make_promise<IInteractive::Result>([defBtn](auto resolve) {
+        return resolve(Result(defBtn));
+    });
 }
 
