 class AppJsModule : public muse::modularity::IModuleSetup
@@ -34,6 +35,20 @@ public:
     void onDeinit() override;
     void onStartApp() override;
 
-private:
+    muse::modularity::IContextSetup* newContext(const muse::modularity::ContextPtr& ctx) const override;
+};
+
+// WebApi needs a real context to resolve contextual services (project session,
+// action dispatcher), so initialise it from a context setup rather than the
+// module (which only has the global context).
+class AppJsContext : public muse::modularity::IContextSetup, public muse::rcommand::Commandable
+{
+public:
+    AppJsContext(const muse::modularity::ContextPtr& ctx)
+        : muse::modularity::IContextSetup(ctx) {}
+
+    void resolveImports() override;
+    void onInit(const muse::IApplication::RunMode& mode) override;
+    void onDeinit() override;
 };
 }
