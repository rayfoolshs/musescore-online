+void WebApi::loadFromPath(const std::string& path)
+{
+    LOGI() << "loadFromPath: " << path;
+
+    // The JS side writes the uploaded file into Emscripten's memory filesystem.
+    // Read it with plain libc (MuseScore's own io layer uses a different view of
+    // the filesystem), then hand the bytes to the normal project-opening flow.
+    FILE* f = ::fopen(path.c_str(), "rb");
+    if (!f) {
+        LOGE() << "failed to open file: " << path;
+        return;
+    }
+
+    ::fseek(f, 0, SEEK_END);
+    const long size = ::ftell(f);
+    ::fseek(f, 0, SEEK_SET);
+
+    if (size <= 0) {
+        ::fclose(f);
+        LOGE() << "empty file: " << path;
+        return;
+    }
+
+    std::vector<char> buf(static_cast<size_t>(size));
+    const size_t read = ::fread(buf.data(), 1, buf.size(), f);
+    ::fclose(f);
+
+    IF_ASSERT_FAILED(read == buf.size()) {
+        LOGE() << "failed to read file: " << path;
+        return;
+    }
+
+    //! NOTE Qt's (MuseScore's) filesystem view is not the same as the libc one used above,
+    //! so the bytes must be written again through the io layer. Keep the original file
+    //! name: the project path drives the title shown in the UI and the names used by
+    //! save / save-as / export.
+    const io::path_t dst = io::path_t(path);
+    io::File::remove(dst);
+    if (!io::File::writeFile(dst, ByteArray(buf.data(), buf.size()))) {
+        LOGE() << "failed to write temporary project file";
+        return;
+    }
+
+    if (!openProjectScenario()) {
+        LOGE() << "open project scenario is not available";
+        return;
+    }
+
+    openProjectScenario()->openProject(dst).onResolve(this, [](const Ret& ret) {
+        if (!ret) {
+            LOGE() << "failed to open project: " << ret.toString();
+        }
+    });
+}
+
+void WebApi::saveScore()
+{
+    saveScoreTo(scoreBaseName() + ".mscz");
+}
+
+void WebApi::saveScoreAs(const std::string& fileName)
+{
+    if (fileName.empty()) {
+        LOGE() << "saveScoreAs: empty file name";
+        return;
+    }
+
+    io::path_t name = io::escapeFileName(fileName);
+    if (io::suffix(name) != "mscz") {
+        name = name + ".mscz";
+    }
+
+    saveScoreTo(name);
+}
+
+void WebApi::requestSaveAs()
+{
+    const io::path_t suggestedName = scoreBaseName() + ".mscz";
+    callJsWithString("onSaveAsRequested", suggestedName.toStdString());
+}
+
+void WebApi::saveScoreTo(const io::path_t& fileName)
+{
+    const project::INotationProjectPtr project = projectSession() ? projectSession()->project() : nullptr;
+    if (!project) {
+        LOGE() << "saveScore: no project";
+        return;
+    }
+
+    //! NOTE Writing the copy is enough: `saveComplited` is already observed in init()
+    //! and that handler pushes the bytes to JS (single download).
+    const io::path_t path = "/mu/temp/" + fileName;
+    const Ret ret = project->save(path, project::SaveMode::SaveCopy, false);
+    if (!ret) {
+        LOGE() << "saveScore: failed to save: " << ret.toString();
+    }
+}
+
+io::path_t WebApi::scoreBaseName()
+{
+    const project::INotationProjectPtr project = projectSession() ? projectSession()->project() : nullptr;
+    if (!project) {
+        return "score";
+    }
+
+    //! NOTE Prefer the score title over the (temporary) project file name.
+    QString title;
+    if (const notation::IMasterNotationPtr masterNotation = project->masterNotation()) {
+        title = masterNotation->notation()->workTitle();
+    }
+
+    // The title falls back to the score name, which may still be a project file name.
+    const std::string titleSuffix = io::suffix(io::path_t(title));
+    if (titleSuffix == "mscz" || titleSuffix == "mscx") {
+        title = io::completeBasename(io::path_t(title)).toQString();
+    }
+
+    if (title.isEmpty()) {
+        title = "score";
+    }
+
+    return io::escapeFileName(title);
+}
+
+void WebApi::exportScore(const std::string& format)
+{
+    std::string suffix;
+    if (format == "musicxml") {
+        suffix = "musicxml";
+    } else if (format == "midi") {
+        suffix = "mid";
+    } else {
+        LOGE() << "exportScore: unsupported format: " << format;
+        return;
+    }
+
+    exportTo(suffix, "onScoreExported");
+}
+
+void WebApi::printScore()
+{
+    exportTo("pdf", "onPrintReady");
+}
+
+void WebApi::exportTo(const std::string& suffix, const char* jsCallback)
+{
+    const project::INotationProjectPtr project = projectSession() ? projectSession()->project() : nullptr;
+    if (!project) {
+        LOGE() << "exportTo: no project";
+        return;
+    }
+
+    const notation::IMasterNotationPtr masterNotation = project->masterNotation();
+    if (!masterNotation || !masterNotation->notation()) {
+        LOGE() << "exportTo: no notation";
+        return;
+    }
+
+    if (!exportProjectScenario()) {
+        LOGE() << "exportTo: export scenario is not available";
+        return;
+    }
+
+    //! NOTE The export writer streams into the Emscripten virtual filesystem, then
+    //! the bytes are handed to JS the same way the "save" flow does.
+    const io::path_t tempDir = "/mu/temp";
+    io::Dir::mkpath(tempDir);
+
+    const io::path_t fileName = scoreBaseName() + "." + suffix.c_str();
+    const io::path_t path = tempDir + "/" + fileName;
+    io::File::remove(path);
+
+    const notation::INotationPtrList notations { masterNotation->notation() };
+    const bool exported = exportProjectScenario()->exportScores(
+        notations, path, project::INotationWriter::UnitType::PER_PART, false);
+    if (!exported) {
+        LOGE() << "exportTo: failed to export to: " << path;
+        return;
+    }
+
+    ByteArray data;
+    const Ret ret = io::File::readFile(path, data);
+    if (!ret) {
+        LOGE() << "exportTo: failed to read exported file: " << path;
+        return;
+    }
+
+    callJsWithNameAndBytes(jsCallback, io::filename(path).toStdString(), data.constData(), data.size());
+}
