 void AppJsModule::onDeinit()
+{
+}
+
+modularity::IContextSetup* AppJsModule::newContext(const muse::modularity::ContextPtr& ctx) const
+{
+    return new AppJsContext(ctx);
+}
+
+void AppJsContext::resolveImports()
+{
+    auto cd = ioc()->resolve<muse::rcommand::ICommandDispatcher>(mname);
+    if (!cd) {
+        return;
+    }
+
+    cd->onRequest(this, muse::rcommand::Command("command://web/score-save"), [](const muse::rcommand::Request&) {
+        WebApi::instance()->saveScore();
+        muse::rcommand::Response response;
+        response.ret = muse::make_ret(muse::Ret::Code::Ok);
+        return response;
+    });
+
+    cd->onRequest(this, muse::rcommand::Command("command://web/score-save-as"), [](const muse::rcommand::Request&) {
+        WebApi::instance()->requestSaveAs();
+        muse::rcommand::Response response;
+        response.ret = muse::make_ret(muse::Ret::Code::Ok);
+        return response;
+    });
+
+    cd->onRequest(this, muse::rcommand::Command("command://web/export-musicxml"), [](const muse::rcommand::Request&) {
+        WebApi::instance()->exportScore("musicxml");
+        muse::rcommand::Response response;
+        response.ret = muse::make_ret(muse::Ret::Code::Ok);
+        return response;
+    });
+
+    cd->onRequest(this, muse::rcommand::Command("command://web/print-score"), [](const muse::rcommand::Request&) {
+        WebApi::instance()->printScore();
+        muse::rcommand::Response response;
+        response.ret = muse::make_ret(muse::Ret::Code::Ok);
+        return response;
+    });
+
+    cd->onRequest(this, muse::rcommand::Command("command://web/export-midi"), [](const muse::rcommand::Request&) {
+        WebApi::instance()->exportScore("midi");
+        muse::rcommand::Response response;
+        response.ret = muse::make_ret(muse::Ret::Code::Ok);
+        return response;
+    });
+}
+
+void AppJsContext::onInit(const muse::IApplication::RunMode&)
+{
+    WebApi::instance()->init(iocContext());
+}
+
+void AppJsContext::onDeinit()
 {
     WebApi::instance()->deinit();
 }
