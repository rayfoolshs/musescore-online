+#elif defined(__EMSCRIPTEN__) && !defined(__EMSCRIPTEN_PTHREADS__)
+//---------------------------------------------------------
+// Semaphore (Emscripten single-threaded WebAssembly)
+// There is only one thread, so a semaphore degenerates to an
+// atomic counter and no blocking is ever required.
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+    std::atomic<std::int64_t> m_count;
+
+    Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+    Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+    Semaphore(int initialCount = 0)
+        : m_count(initialCount)
+    {
+        assert(initialCount >= 0);
+    }
+
+    ~Semaphore() {}
+
+    bool wait()
+    {
+        std::int64_t c = m_count.load(std::memory_order_relaxed);
+        while (c > 0) {
+            if (m_count.compare_exchange_weak(c, c - 1, std::memory_order_relaxed)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    bool try_wait()
+    {
+        return wait();
+    }
+
+    bool timed_wait(std::uint64_t /*usecs*/)
+    {
+        return wait();
+    }
+
+    void signal()
+    {
+        m_count.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void signal(int count)
+    {
+        m_count.fetch_add(count, std::memory_order_relaxed);
+    }
+};
+
 #elif defined(__unix__) || defined(__MVS__)
 //---------------------------------------------------------
 // Semaphore (POSIX, Linux, zOS)
